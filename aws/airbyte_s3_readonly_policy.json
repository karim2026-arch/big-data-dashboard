{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListFleetBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::fleet-telematics-lakehouse-team11"
    },
    {
      "Sid": "ReadFleetObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::fleet-telematics-lakehouse-team11/*"
    }
  ]
}
