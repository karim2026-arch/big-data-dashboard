# Copy to .env.local and edit. Only VITE_* values reach the browser: never put secrets here.
# mock = in-browser fake data | api = real backend (warehouse KPIs over REST + live stream over SSE)
VITE_DATA_SOURCE=mock
VITE_API_BASE_URL=http://localhost:8000/api
VITE_STREAM_URL=http://localhost:8000/api/stream
